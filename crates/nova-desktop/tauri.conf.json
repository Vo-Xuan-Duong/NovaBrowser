{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaBrowser",
  "version": "0.1.0",
  "identifier": "com.novabrowser.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NovaBrowser",
        "width": 1280,
        "height": 820,
        "minWidth": 740,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": false
  }
}

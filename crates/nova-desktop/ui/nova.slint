import { Button, LineEdit } from "std-widgets.slint";

export component NovaWindow inherits Window {
    title: "NovaBrowser — Desktop Preview";
    width: 1280px;
    height: 840px;
    background: #f7f9fc;

    in-out property <string> address: "https://example.com";
    in property <string> status: "Starting NovaBrowser engine...";
    in property <bool> loading: false;
    in property <image> page-image;

    callback navigate(string);
    callback back();
    callback forward();
    callback reload();
    callback page-click(float, float);
    callback page-scroll(float, float);
    callback page-key(string);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 56px;
            background: #182237;

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Button {
                    text: "<";
                    width: 44px;
                    clicked => { root.back(); }
                }
                Button {
                    text: ">";
                    width: 44px;
                    clicked => { root.forward(); }
                }
                Button {
                    text: "↻";
                    width: 44px;
                    clicked => { root.reload(); }
                }
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.address;
                    placeholder-text: "Search or enter a website address";
                    accepted(text) => { root.navigate(text); }
                }
                Button {
                    text: "Go";
                    width: 54px;
                    clicked => { root.navigate(root.address); }
                }
            }
        }

        Rectangle {
            background: #ffffff;
            vertical-stretch: 1;

            page-focus := FocusScope {
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                        reject
                    } else {
                        if (event.text == Key.Backspace) {
                            root.page-key("__NOVA_BACKSPACE__");
                        } else {
                            root.page-key(event.text);
                        }
                        accept
                    }
                }

                Image {
                    source: root.page-image;
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        page-focus.focus();
                        root.page-click(self.mouse-x / self.width, self.mouse-y / self.height);
                    }
                    scroll-event(event) => {
                        root.page-scroll(event.delta-x / 1px, event.delta-y / 1px);
                        accept
                    }
                }
            }
        }

        Rectangle {
            height: 28px;
            background: #e8edf5;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: root.status;
                    color: #344054;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// Chrome-inspired light browser chrome for NovaBrowser.
// One active tab is real; other-tab controls are deliberately not faked.
// Native Windows title-bar controls remain owned by the window manager.

component ToolbarAction inherits Rectangle {
    in property <string> icon-data: "";
    in property <bool> available: true;
    callback activated();

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: !root.available ? transparent
        : pointer.pressed ? #dce5f4
        : pointer.has-hover ? #edf1f7
        : transparent;

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        commands: root.icon-data;
        stroke: root.available ? #414b5b : #b3bac6;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    pointer := TouchArea {
        enabled: root.available;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component NovaWindow inherits Window {
    title: root.tab-title + " - NovaBrowser";
    width: 1280px;
    height: 820px;
    min-width: 740px;
    min-height: 500px;
    background: #ffffff;

    in-out property <string> address: "https://example.com";
    in property <string> tab-title: "New tab";
    in property <string> status: "Starting browser engine";
    in property <bool> loading: false;
    in property <bool> show-status: false;
    in property <bool> can-back: false;
    in property <bool> can-forward: false;
    in property <image> page-image;
    out property <float> viewport-width: web-panel.width / 1px;
    out property <float> viewport-height: web-panel.height / 1px;

    changed viewport-width => { root.viewport-resized(root.viewport-width, root.viewport-height); }
    changed viewport-height => { root.viewport-resized(root.viewport-width, root.viewport-height); }

    callback navigate(string);
    callback back();
    callback forward();
    callback reload();
    callback page-click(float, float);
    callback page-scroll(float, float, float, float);
    callback page-key(string);
    callback viewport-resized(float, float);

    VerticalLayout {
        spacing: 0px;

        // Rounded, connected-looking active tab on a muted strip.
        Rectangle {
            height: 42px;
            background: #dfe4ed;

            HorizontalLayout {
                padding-left: 13px;
                padding-right: 13px;
                padding-top: 7px;
                padding-bottom: 0px;
                spacing: 8px;

                Rectangle {
                    width: 245px;
                    height: 35px;
                    border-radius: 13px;
                    background: #ffffff;

                    HorizontalLayout {
                        padding-left: 13px;
                        padding-right: 13px;
                        spacing: 10px;

                        Rectangle {
                            width: 17px;
                            height: 17px;
                            border-radius: 9px;
                            background: #3d84e7;

                            Text {
                                text: "N";
                                color: white;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.loading ? "Loading..." : root.tab-title;
                            color: #263248;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        // Compact toolbar: Back / Forward / Reload and a single omnibox.
        Rectangle {
            height: 56px;
            background: #ffffff;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 5px;

                ToolbarAction {
                    icon-data: "M 18 5 L 11 12 L 18 19 M 11 12 L 5 12";
                    available: root.can-back;
                    activated => { root.back(); }
                }

                ToolbarAction {
                    icon-data: "M 6 5 L 13 12 L 6 19 M 13 12 L 19 12";
                    available: root.can-forward;
                    activated => { root.forward(); }
                }

                ToolbarAction {
                    icon-data: "M 20 11 A 8 8 0 1 0 18 17 M 20 5 L 20 11 L 14 11";
                    activated => { root.reload(); }
                }

                Rectangle { width: 4px; background: transparent; }

                // The TextInput is drawn inside a custom pill instead of
                // inheriting the platform-dependent LineEdit background.
                omnibox := Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: 20px;
                    background: address-edit.has-focus ? #ffffff : #f0f3f8;
                    border-width: address-edit.has-focus ? 2px : 1px;
                    border-color: address-edit.has-focus ? #75a5ef : #edf0f5;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 11px;

                        // Neutral site-control symbol: not a misleading
                        // security lock or an unimplemented settings button.
                        Path {
                            width: 18px;
                            height: 18px;
                            commands: "M 3 7 H 21 M 3 17 H 21 M 9 5 V 9 M 15 15 V 19";
                            stroke: #69788c;
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                        }

                        input-clip := Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            background: transparent;
                            clip: true;

                            address-edit := TextInput {
                                in-out property <length> text-offset: 0px;
                                x: self.text-offset;
                                y: 0px;
                                width: max(parent.width, self.preferred-width + 12px);
                                height: parent.height;
                                text <=> root.address;
                                single-line: true;
                                font-size: 14px;
                                color: #252b36;
                                selection-background-color: #b9d7ff;
                                selection-foreground-color: #18283c;
                                vertical-alignment: center;

                                cursor-position-changed(position) => {
                                    if (position.x + self.text-offset > parent.width - 12px) {
                                        self.text-offset = parent.width - position.x - 12px;
                                    } else if (position.x + self.text-offset < 0px) {
                                        self.text-offset = -position.x;
                                    }
                                }
                                accepted => { root.navigate(self.text); }
                            }

                            Text {
                                visible: root.address == "" && !address-edit.has-focus;
                                width: 100%;
                                height: 100%;
                                text: "Search or type a URL";
                                color: #808b9d;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Keep the whole left/right pill padding clickable.
                    // This does not obscure the TextInput in the center.
                    omni-pointer := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: 30px;
                        height: 100%;
                        mouse-cursor: text;
                        clicked => {
                            address-edit.focus();
                            address-edit.select-all();
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 2px;
            background: root.loading ? #6a9ef5 : #ffffff;
        }

        // Web area remains edge to edge; no persistent bottom status bar.
        web-panel := Rectangle {
            background: #ffffff;
            vertical-stretch: 1;

            browser-focus := FocusScope {
                width: 100%;
                height: 100%;

                key-pressed(event) => {
                    if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                        reject
                    } else {
                        if (event.text == Key.Backspace) {
                            root.page-key("__NOVA_BACKSPACE__");
                        } else if (event.text == Key.Delete) {
                            root.page-key("__NOVA_DELETE__");
                        } else if (event.text == Key.Return) {
                            root.page-key("__NOVA_ENTER__");
                        } else if (event.text != "") {
                            root.page-key(event.text);
                        }
                        accept
                    }
                }

                KeyBinding {
                    keys: @keys(Control + L);
                    activated => {
                        address-edit.focus();
                        address-edit.select-all();
                    }
                }
                KeyBinding {
                    keys: @keys(Control + R);
                    activated => { root.reload(); }
                }
                KeyBinding {
                    keys: @keys(F5);
                    activated => { root.reload(); }
                }

                Image {
                    source: root.page-image;
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        browser-focus.focus();
                        root.page-click(self.mouse-x / self.width, self.mouse-y / self.height);
                    }
                    scroll-event(event) => {
                        root.page-scroll(
                            self.mouse-x / self.width,
                            self.mouse-y / self.height,
                            event.delta-x / 1px,
                            event.delta-y / 1px
                        );
                        accept
                    }
                }
            }

            // Chrome-style status bubble: only loading and errors are shown.
            Rectangle {
                visible: root.loading || root.show-status;
                x: 0px;
                y: parent.height - self.height;
                width: min(parent.width, 470px);
                height: 28px;
                background: #f8fafd;
                border-radius: 6px;
                border-width: 1px;
                border-color: #dce3ec;

                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: root.status;
                    color: #526071;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
